# /etc/tor/torrc (architecture §15.3). Generated by install.sh.
SocksPort 0
SafeLogging 1
Log notice syslog

HiddenServiceDir /var/lib/tor/asiri/
HiddenServicePort 80 127.0.0.1:8080
HiddenServicePort 7880 127.0.0.1:7880
# Restricted discovery: one file per authorized device in
#   /var/lib/tor/asiri/authorized_clients/<device>.auth
# containing "descriptor:x25519:<base32 public key>". asiri-authsync maintains them.

HiddenServiceDir /var/lib/tor/admin/
HiddenServicePort 22 127.0.0.1:22
# Add your own client key to /var/lib/tor/admin/authorized_clients/ to reach SSH over Tor
# (see server/deploy/README.md, "Onion-only SSH").
