# /opt/asiri/livekit.yaml (architecture §10.3). Generated by install.sh.
port: 7880                    # signaling: loopback only, reached through the onion service
bind_addresses: ["127.0.0.1"]
key_file: /etc/livekit-keys.yaml   # used only by asiri-relay to mint tokens
rtc:
  tcp_port: 7881              # TCP fallback for media (public)
  udp_port: 7882              # single UDP port for all media (public)
  use_external_ip: false
  node_ip: "@NODE_IP@"        # the VPS's public IPv4 address
logging:
  level: warn
  pion_level: error
room:
  empty_timeout: 60
  departure_timeout: 20
  max_participants: 12
turn:
  enabled: false              # native clients reach UDP 7882 or TCP 7881 directly
